# Enquiry email delivery. Keep real values only in Vercel/environment files, never Git.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Add these only after the correct www domain is connected and verified.
# Search Console and Bing give you the exact values during ownership verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Safety gate: leave false until https://www.kaaveritoursandtravels.com is live,
# the apex redirects to it, and Search Console verification is complete.
NEXT_PUBLIC_ALLOW_INDEXING=false
