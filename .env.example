# Enquiry email delivery (Resend). Keep real values only in Vercel/environment files, never Git.
# RESEND_API_KEY: a "Sending access" key from a Resend account registered with the business Gmail.
# ENQUIRY_FROM_EMAIL: Kaaveri Website <onboarding@resend.dev> (Resend's shared sender; it can only deliver to the
#   account's own address, which is the enquiry inbox). After verifying kaaveritoursandtravels.com in Resend,
#   switch to a sender on that domain for better deliverability; no mailbox is needed for it.
# Enquiries are delivered to the business inbox set in src/lib/enquiry-delivery.server.ts.
# Without both values the form stays usable: it hands the visitor's details to WhatsApp instead.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Search engine ownership tokens, from Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Safety gate: production is hidden from search engines unless this is exactly "true".
# The canonical address is https://kaaveritoursandtravels.com (www should redirect to it).
# Set to true in Vercel Production before deploying the site you want indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false
